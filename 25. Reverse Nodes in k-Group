
class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {

        ListNode dummy = new ListNode(0);
        dummy.next = head;

        ListNode prev = dummy;

        while (true) {

            ListNode end = prev;

            for (int i = 0; i < k && end != null; i++) {
                end = end.next;
            }

            if (end == null)
                break;

            ListNode start = prev.next;
            ListNode next = end.next;

            ListNode curr = start;
            ListNode before = next;

            while (curr != next) {
                ListNode temp = curr.next;
                curr.next = before;
                before = curr;
                curr = temp;
            }

            prev.next = end;
            prev = start;
        }

        return dummy.next;
    }
}
